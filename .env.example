# Aplikasi & Port
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Metadata Perusahaan & WhatsApp Hotline
NEXT_PUBLIC_COMPANY_NAME="PT IHSAN ABDUL PATAH"
NEXT_PUBLIC_COMPANY_SHORT_NAME="PT. IAP"
NEXT_PUBLIC_COMPANY_ADDRESS="Jl. Lulurung II, Kp. Cijengkol RT/RW 001/006, Desa Wangunsari, Kec. Lembang, Kab. Bandung Barat, 40391"

# Nomor WhatsApp Resmi Customer Service & Sales (format tanpa tanda +, contoh: 6285265458819)
NEXT_PUBLIC_WA_PRIMARY="6285265458819"
NEXT_PUBLIC_WA_SECONDARY="6285222579391"

